[Unit]
Description=Investeq Resistance Marker — interactive swing-high resistance on the visible chart window (FastAPI on 8709, served at /resistance)
After=network.target

[Service]
Type=simple
User=ajay
Group=ajay
WorkingDirectory=/home/ajay/investeq_ajs
EnvironmentFile=/etc/investeq.env
Environment=APP_BASE=/resistance
ExecStart=/home/ajay/investeq_ajs/.venv/bin/python -m uvicorn stock_resistance.app:app --host 127.0.0.1 --port 8709
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

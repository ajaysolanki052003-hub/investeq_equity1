[Unit]
Description=Investeq Expiry Blast — short-covering entry engine (mounted at /blast)
After=network.target

[Service]
Type=simple
User=ajay
Group=ajay
WorkingDirectory=/home/ajay/investeq_ajs
EnvironmentFile=/etc/investeq.env
Environment=APP_BASE=/blast
Environment=INVESTEQ_DATA=/home/ajay/investeq_ajs/DATA
ExecStart=/home/ajay/investeq_ajs/.venv/bin/python -m uvicorn expiry_blast.app:app --host 127.0.0.1 --port 8706
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

[Unit]
Description=Investeq option-chain replay (mounted at /chain)
After=network.target

[Service]
Type=simple
User=ajay
Group=ajay
WorkingDirectory=/home/ajay/investeq_ajs
EnvironmentFile=/etc/investeq.env
Environment=APP_BASE=/chain
ExecStart=/home/ajay/investeq_ajs/.venv/bin/python -m uvicorn app_chain_replay:app --host 127.0.0.1 --port 8704
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

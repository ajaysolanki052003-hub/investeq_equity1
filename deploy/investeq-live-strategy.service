[Unit]
Description=Investeq live Strategy Suite data worker (NIFTY 1m bars + ATM±1 OI, NSE hours only)
After=network.target

[Service]
Type=simple
User=ajay
Group=ajay
WorkingDirectory=/home/ajay/investeq_ajs
EnvironmentFile=/etc/investeq.env
Environment=INVESTEQ_DATA=/home/ajay/investeq_ajs/DATA
ExecStart=/home/ajay/investeq_ajs/.venv/bin/python live_strategy_worker.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

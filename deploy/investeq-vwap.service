[Unit]
Description=Investeq VWAP Touch Screener — which stocks touched their Weekly/Monthly VWAP on a day (FastAPI on 8711, served at /vwap)
After=network.target

[Service]
Type=simple
User=ajay
Group=ajay
WorkingDirectory=/home/ajay/investeq_ajs
EnvironmentFile=/etc/investeq.env
Environment=APP_BASE=/vwap
ExecStart=/home/ajay/investeq_ajs/.venv/bin/python -m uvicorn stock_vwap.app:app --host 127.0.0.1 --port 8711
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

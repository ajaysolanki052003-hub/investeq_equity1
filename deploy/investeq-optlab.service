[Unit]
Description=Investeq Option Indicator Lab — live + replay technical indicators on any NIFTY option contract (FastAPI on 8708, served at /optlab)
After=network.target

[Service]
Type=simple
User=ajay
Group=ajay
WorkingDirectory=/home/ajay/investeq_ajs
EnvironmentFile=/etc/investeq.env
Environment=APP_BASE=/optlab
ExecStart=/home/ajay/investeq_ajs/.venv/bin/python -m uvicorn option_indicators.app:app --host 127.0.0.1 --port 8708
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

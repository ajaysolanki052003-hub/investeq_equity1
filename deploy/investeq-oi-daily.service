[Unit]
Description=Investeq daily NIFTY options OI fetch (one-shot, triggered by .timer)

[Service]
Type=oneshot
User=ajay
Group=ajay
WorkingDirectory=/home/ajay/investeq_ajs
EnvironmentFile=/etc/investeq.env
Environment=INVESTEQ_DATA=/home/ajay/investeq_ajs/DATA
# Fetch every missing day's INTRADAY OI from Groww historical-candles
# (correct symbol format NSE-NIFTY-DDMmmYY-strike-CE/PE) + rebuild the
# ATM±1 aggregate. --catchup picks up from the last existing OI file.
ExecStart=/home/ajay/investeq_ajs/.venv/bin/python fetch_oi_intraday.py --catchup --pad 2 --delay 0.25
ExecStartPost=/home/ajay/investeq_ajs/.venv/bin/python build_atm_oi_intraday.py
StandardOutput=journal
StandardError=journal
